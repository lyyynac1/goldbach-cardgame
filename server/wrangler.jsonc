{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldbach-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  // POST /room 等プレーンHTTPエンドポイントへのCORS許可オリジン。
  // カンマ区切りで複数指定可(例: "https://a.example.com,https://b.example.com")。
  // WebSocket(/room/<code>)自体はCORSの対象外なのでここには関係しない。
  // これはデフォルト(wrangler devでのローカル開発用)の値。
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:8081"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "env": {
    // 本番用。`wrangler deploy --env production` で使う。
    // name を明示的に指定しないと `<base name>-production` になってしまうため、
    // ここで公開用のWorker名(cardgame)を上書きする。
    "production": {
      "name": "cardgame",
      "vars": {
        "ALLOWED_ORIGIN": "https://play.goldbach.workers.dev"
      },
      // durable_objects はenvironmentに自動継承されないため明示的に複製する。
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          }
        ]
      }
    }
  }
}
